# FORMA-LRD config preset: EIGER F356W WFSS, single arm.
# Copy relevant lines into your .env (never commit a real .env — see .gitignore).

# Redrock is useless here (rest-UV/optical templates; our redshifts are
# known) and Kapoor+26 supplies the line-identity hypotheses directly.
REDROCK=false
HYPOTHESIS_PROVIDER=lrd

# Single-arm FITS written by lrd_adapt/converter/grizli_to_forma.py.
# 31500-39500 Angstrom == 3.15-3.95 um observed coverage (CLAUDE.md).
ARM_NAME=F356W
ARM_WAVELENGTH_RANGE=31500-39500

# CWT_MAX_SCALE is in pixels (scale x 2.355 =approx= FWHM in px), not
# Angstrom, so this is not a direct copy of CLAUDE.md's "~300 A" note (finding
# #10). At F356W's ~9.8 A/pixel (1 LW pixel = 0.063" ~= 9.8 A), a scale of
# ~300 px would be absurdly wide; the working choice below targets a scale
# whose FWHM (scale * 2.355 * 9.8 A) comfortably covers LRD broad components
# observed at 1400-2100 km/s (~160-250 A at these wavelengths). Re-derive and
# document precisely once real J1030 extractions are in hand.
CWT_MAX_SCALE=14.0
